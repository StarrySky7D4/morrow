  "visualCornerTips1": "Not every idea has to be useful.\nSome simply make today more interesting.",
  "@visualCornerTips1": {
    "description": "Visual interface: CornerTips1"
  },
  "visualCornerTips2": "Write it down, then let it grow.\nAn idea does not have to arrive complete.",
  "@visualCornerTips2": {
    "description": "Visual interface: CornerTips2"
  },
  "visualCornerTips3": "Leave a little space for yourself.\nCuriosity needs room to breathe.",
  "@visualCornerTips3": {
    "description": "Visual interface: CornerTips3"
  },
  "visualCornerTips4": "Try something new today.\nA small detour can bring a surprise.",
  "@visualCornerTips4": {
    "description": "Visual interface: CornerTips4"
  },
  "visualCornerTips5": "Daydreaming can lead somewhere.\nGive your thoughts a path to wander.",
  "@visualCornerTips5": {
    "description": "Visual interface: CornerTips5"
  },
  "visualCornerTips6": "Make time for what you love.\nThere is no need to prove its worth.",
  "@visualCornerTips6": {
    "description": "Visual interface: CornerTips6"
  },
  "visualCornerTips7": "Progress can be small.\nBeing willing to start already matters.",
  "@visualCornerTips7": {
    "description": "Visual interface: CornerTips7"
  },
  "visualCornerTips8": "Look out the window sometimes.\nLife is a source of inspiration too.",
  "@visualCornerTips8": {
    "description": "Visual interface: CornerTips8"
  },
  "visualFooterTips1": "Nothing urgent. Give curiosity a little time.",
  "@visualFooterTips1": {
    "description": "Visual interface: FooterTips1"
  },
  "visualFooterTips2": "Jot down a thought. You can organize it later.",
  "@visualFooterTips2": {
    "description": "Visual interface: FooterTips2"
  },
  "visualFooterTips3": "Break a big idea into one small step for today.",
  "@visualFooterTips3": {
    "description": "Visual interface: FooterTips3"
  },
  "visualFooterTips4": "Stretch a little and rest your eyes.",
  "@visualFooterTips4": {
    "description": "Visual interface: FooterTips4"
  },
  "visualFooterTips5": "An idea is allowed to remain unanswered for now.",
  "@visualFooterTips5": {
    "description": "Visual interface: FooterTips5"
  },
  "visualFooterTips6": "Some discoveries arrive when you slow down.",
  "@visualFooterTips6": {
    "description": "Visual interface: FooterTips6"
  },
  "visualFooterTips7": "Saving a detail is a way to nurture an idea.",
  "@visualFooterTips7": {
    "description": "Visual interface: FooterTips7"
  },
  "visualFooterTips8": "A quick note today might become tomorrow''s beginning.",
  "@visualFooterTips8": {
    "description": "Visual interface: FooterTips8"
  },
  "visualFooterTips9": "Let your mind wander, then return to what you enjoy.",
  "@visualFooterTips9": {
    "description": "Visual interface: FooterTips9"
  },
  "visualFooterTips10": "You do not have to fill every minute. Leave some room.",
  "@visualFooterTips10": {
    "description": "Visual interface: FooterTips10"
  },
