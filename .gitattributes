# Frozen compatibility originals: preserve every byte across checkouts.
/sdk/compat/guest-v1-rc1/** -text
/sdk/compat/*.sha256 text eol=lf

/sdk/compat/transport-v1-rc1/** -text

# build_i18n.py checks deterministic generated text byte for byte.
/packages/morrow_i18n/lib/l10n/*.arb text eol=lf
/packages/morrow_i18n/lib/locale_codes.dart text eol=lf
/packages/morrow_i18n/lib/src/generated/language_pins.dart text eol=lf
/packages/morrow_i18n/l10n.yaml text eol=lf
/workbench_host/src/generated_ui_locales.rs text eol=lf

# Theme descriptor is embedded verbatim in the immutable Wasm package.
/plugins/mid_autumn/theme.json text eol=lf

# M03 qualification inputs and companion snapshot are bound by byte hashes.
/companions/morrow-codex/** -text
/contracts/experimental/** -text
/native_pipe_win_001/** -text
/native_session/** -text
/native_session_owner_002/** -text
/native_session_stream_001/** -text
/network_node_stream_001/** -text
/reports/codex-morrow-v1.1/** -text
/tool/m02_* -text
/tool/m03_* -text
/tool/tests/test_m03_* -text
/tool/agent_host_build.py -text
/tool/tests/test_agent_host_build.py -text

# Service resources use exact schema bytes for SDK/host compatibility.
/core/schemas/service_resources.capnp text eol=lf
/sdk/rust/contracts/service_resources.capnp text eol=lf
# Qualification receipts bind these probe sources byte for byte.
/tool/qualification/m03-pipe-driver-check/** -text
