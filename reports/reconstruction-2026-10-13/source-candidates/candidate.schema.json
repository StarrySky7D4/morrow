{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morrow source candidate archive metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "source_versions",
    "integration",
    "compiled_by_source_author",
    "runtime_executed",
    "windows_resource_proof",
    "sdk_freeze",
    "execution_authority",
    "release_eligible",
    "license",
    "overlay_root",
    "files",
    "known_gaps",
    "original_test_declarations"
  ],
  "properties": {
    "schema": {
      "const": "MORROW_SOURCE_CANDIDATE_ARCHIVE_V1"
    },
    "candidate": {
      "const": "failed-startup-quarantine"
    },
    "source_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger",
        "runtime"
      ],
      "properties": {
        "ledger": {
          "const": "347-001"
        },
        "runtime": {
          "const": "350-002"
        }
      }
    },
    "integration": {
      "const": "ARCHIVED_ONLY_NOT_ACTIVATED"
    },
    "compiled_by_source_author": {
      "const": false
    },
    "runtime_executed": {
      "const": false
    },
    "windows_resource_proof": {
      "const": "NOT_ESTABLISHED"
    },
    "sdk_freeze": {
      "const": false
    },
    "execution_authority": {
      "const": false
    },
    "release_eligible": {
      "const": false
    },
    "license": {
      "const": "AGPL-3.0-only"
    },
    "overlay_root": {
      "const": "quarantine-runtime/overlay"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "original_test_declarations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
