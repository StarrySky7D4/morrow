  "findings": [
    {
      "id": "PICKER_OWNER_EPOCH",
      "status": "CHANGES_REQUIRED_BASELINE",
      "runtime_trigger": "NOT_RUN",
      "sources": [
        "Index.ets:484-488",
        "MusicWorkbench.ets:264-272",
        "MusicWorkbench.ets:341-347",
        "EntryAbility.ets:80-89"
      ],
      "detail": "Authorized DocumentViewPicker round trip is rejected after any background/foreground epoch change; normal add clears selected URI grant registry, and lyrics text is discarded before unsavedLyrics assignment. Local SDK specifies picker-page launch and promise URI result, not lifecycle ordering."
    },
    {
      "id": "MISSING_STYLE_INSETS",
      "status": "CHANGES_REQUIRED_BASELINE",
      "sources": [
        "MusicPanel.ets:40",
        "music_panel.dart:274-276",
        "music_panel.dart:516-518",
        "experimental_controls.dart:226-328"
      ],
      "detail": "paper/fluent/brutalist/industrial return without painting current-track and selected-row inset. Flutter defines distinct inset painters for each."
    },
    {
      "id": "UNREQUESTED_INSET_FILL",
      "status": "CHANGES_REQUIRED_BASELINE",
      "sources": [
        "MusicPanel.ets:299",
        "MusicPanel.ets:377",
        "neumorphic_controls.dart:23",
        "neumorphic_controls.dart:118-159"
      ],
      "detail": "Current track and selected row force an ink-alpha fill. Flutter NeumorphicSurface default fill=false paints no flat edge or fill, preserving outer material."
    }
  ],
