# Runs after flutter_assemble. CMake's REALPATH leaves Windows junctions intact
# in some versions, and file(INSTALL DIRECTORY) copies them as unusable NT-path
# symlinks. Resolve the root link explicitly, then install its real contents.
foreach(required MORROW_ASSET_SOURCE MORROW_ASSET_DESTINATION MORROW_BUNDLE_ROOT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing Windows asset install path: ${required}")
  endif()
endforeach()

get_filename_component(asset_source "${MORROW_ASSET_SOURCE}" ABSOLUTE)
foreach(hop RANGE 0 31)
  if(NOT IS_SYMLINK "${asset_source}")
    break()
  endif()
  file(READ_SYMLINK "${asset_source}" link_target)
  string(REPLACE "\\" "/" link_target "${link_target}")
  string(LENGTH "${link_target}" target_length)
  if(target_length GREATER 4)
    string(SUBSTRING "${link_target}" 0 4 prefix)
    if(prefix STREQUAL "/??/" OR prefix STREQUAL "//?/")
      string(SUBSTRING "${link_target}" 4 -1 link_target)
      if(link_target MATCHES "^UNC/")
        string(SUBSTRING "${link_target}" 4 -1 link_target)
        set(link_target "//${link_target}")
      elseif(NOT link_target MATCHES "^[A-Za-z]:/")
        message(FATAL_ERROR "Unsupported Windows asset junction target")
      endif()
    endif()
  endif()
  get_filename_component(link_parent "${asset_source}" DIRECTORY)
  get_filename_component(asset_source "${link_target}" ABSOLUTE BASE_DIR "${link_parent}")
endforeach()
if(IS_SYMLINK "${asset_source}" OR NOT IS_DIRECTORY "${asset_source}")
  message(FATAL_ERROR "Windows asset source is missing or has a link cycle")
endif()

get_filename_component(bundle_root "${MORROW_BUNDLE_ROOT}" ABSOLUTE)
get_filename_component(destination "${MORROW_ASSET_DESTINATION}" ABSOLUTE)
# Only the known data subtree of this application bundle can be replaced.
if(NOT destination STREQUAL "${bundle_root}/data/flutter_assets" OR destination STREQUAL asset_source)
  message(FATAL_ERROR "Windows asset destination is outside its application bundle")
endif()
if(IS_SYMLINK "${destination}")
  file(REMOVE "${destination}")
else()
  file(REMOVE_RECURSE "${destination}")
endif()
file(INSTALL DESTINATION "${destination}" TYPE DIRECTORY FILES "${asset_source}/")
