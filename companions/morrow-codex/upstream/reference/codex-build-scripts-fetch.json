"path":"codex-rs/websocket-auth/build.rs","error":"GitHub API error 404: {\"message\":\"Not Found\",\"documentation_url\":\"https://docs.github.com/rest/repos/contents#get-repository-content\",\"status\":\"404\"}","error_code":"NOT_FOUND","error_data":{"message":"Not Found","documentation_url":"https://docs.github.com/rest/repos/contents#get-repository-content","status":"404"}},{"path":"codex-rs/websocket-client/build.rs","error":"GitHub API error 404: {\"message\":\"Not Found\",\"documentation_url\":\"https://docs.github.com/rest/repos/contents#get-repository-content\",\"status\":\"404\"}","error_code":"NOT_FOUND","error_data":{"message":"Not Found","documentation_url":"https://docs.github.com/rest/repos/contents#get-repository-content","status":"404"}},{"path":"codex-rs/windows-sandbox-rs/build.rs","content":"use std::env;\nuse std::path::PathBuf;\n\nconst SETUP_BIN: &str = \"codex-windows-sandbox-setup\";\nconst SETUP_MANIFEST: &str = \"codex-windows-sandbox-setup.manifest\";\n\nfn main() -> Result<(), String> {\n    println!(\"cargo:rerun-if-changed={SETUP_MANIFEST}\");\n\n    if env::var(\"CARGO_CFG_TARGET_OS\").as_deref() != Ok(\"windows\") {\n        return Ok(());\n    }\n\n    let manifest_dir = env::var_os(\"CARGO_MANIFEST_DIR\")\n        .ok_or_else(|| \"CARGO_MANIFEST_DIR should be set for build scripts\".to_string())?;\n    let manifest_path = PathBuf::from(manifest_dir).join(SETUP_MANIFEST);\n    let manifest_path = manifest_path.display();\n\n    // Keep this scoped to the setup helper so Codex binaries that link the\n    // library do not inherit any resource metadata from this package.\n    match (\n        env::var(\"CARGO_CFG_TARGET_ENV\").as_deref(),\n        env::var(\"CARGO_CFG_TARGET_ABI\").as_deref(),\n    ) {\n        (Ok(\"msvc\"), _) => {\n            println!(\"cargo:rustc-link-arg-bin={SETUP_BIN}=/MANIFEST:EMBED\");\n            println!(\"cargo:rustc-link-arg-bin={SETUP_BIN}=/MANIFESTINPUT:{manifest_path}\");\n        }\n        (Ok(\"gnu\"), Ok(\"llvm\")) => {\n            println!(\"cargo:rustc-link-arg-bin={SETUP_BIN}=-Wl,-Xlink=/manifest:embed\");\n            println!(\n                \"cargo:rustc-link-arg-bin={SETUP_BIN}=-Wl,-Xlink=/manifestinput:{manifest_path}\"\n            );\n        }\n        _ => {}\n    }\n\n    Ok(())\n}\n","encoding":"utf-8","sha":"6ba79e6c75deb87067ced02e824eaf7faf79346d","display_url":"https://github.com/openai/codex/blob/44fe510ce3ee61c8ef623adcbf89b901c73ddd61/codex-rs/windows-sandbox-rs/build.rs","display_title":"build.rs"},{"path":"codex-rs/workload-identity/build.rs","error":"GitHub API error 404: {\"message\":\"Not Found\",\"documentation_url\":\"https://docs.github.com/rest/repos/contents#get-repository-content\",\"status\":\"404\"}","error_code":"NOT_FOUND","error_data":{"message":"Not Found","documentation_url":"https://docs.github.com/rest/repos/contents#get-repository-content","status":"404"}}]
