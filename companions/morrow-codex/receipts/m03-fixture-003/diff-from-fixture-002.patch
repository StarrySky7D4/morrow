+        assert!(!f.join_until(deadline).await);
+        assert_eq!(f.snapshot()["writer_joined"], false);
+        assert!(
+            session
+                .control_thread_observations()
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|o| o["handle_retained"] == true)
