(module
  (import "morrow_task_v1" "read_input" (func $read_input (param i32 i32) (result i32)))
  (import "morrow_task_v1" "complete" (func $complete (param i32 i32) (result i32)))
  (import "morrow_v1" "exchange" (func $exchange (param i32 i32 i32 i32) (result i32)))
  (import "morrow_io_v1" "call" (func $io_call (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 5)
  (global $entries (mut i32) (i32.const 0))
  (data (i32.const 0) "core")
  (data (i32.const 16) "io")
  (data (i32.const 32) "done")
  (func (export "morrow_run") (result i32)
    (local $seed i32)
    (local $first i32)
    (local $ret i32)
    (global.set $entries (i32.add (global.get $entries) (i32.const 1)))
    (if (i32.ne (global.get $entries) (i32.const 1)) (then unreachable))
    (drop (call $read_input (i32.const 131072) (i32.const 131072)))
    (local.set $seed (i32.const 41))
    (local.set $ret (call $exchange (i32.const 0) (i32.const 4) (i32.const 65536) (i32.const 65536)))
    (if (i32.ne (local.get $ret) (i32.const 4)) (then unreachable))
    (local.set $first (i32.load (i32.const 65536)))
    (local.set $ret (call $io_call (i32.const 16) (i32.const 2) (i32.const 131072) (i32.const 131072)))
    (if (i32.ne (local.get $ret) (i32.const 4)) (then unreachable))
    (if (i32.ne (i32.add (local.get $seed) (i32.add (local.get $first) (i32.load (i32.const 131072)))) (i32.const 61)) (then unreachable))
    (if (i32.ne (global.get $entries) (i32.const 1)) (then unreachable))
    (local.set $ret (call $complete (i32.const 32) (i32.const 4)))
    (if (i32.ne (local.get $ret) (i32.const 0)) (then unreachable))
    (i32.const 0)))
